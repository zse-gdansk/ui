{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "packages": {
        ".": {
            "release-type": "node",
            "include-component-in-tag": false,
            "pull-request-title-pattern": "chore${scope}: wydano ${version}",
            "changelog-sections": [
                {
                    "type": "feat",
                    "section": "Nowe funkcje"
                },
                {
                    "type": "fix",
                    "section": "Poprawki"
                },
                {
                    "type": "perf",
                    "section": "Wydajność"
                },
                {
                    "type": "revert",
                    "section": "Wycofane zmiany"
                },
                {
                    "type": "docs",
                    "section": "Dokumentacja"
                },
                {
                    "type": "refactor",
                    "section": "Refaktoryzacja",
                    "hidden": true
                },
                {
                    "type": "style",
                    "section": "Styl kodu",
                    "hidden": true
                },
                {
                    "type": "test",
                    "section": "Testy",
                    "hidden": true
                },
                {
                    "type": "build",
                    "section": "Build",
                    "hidden": true
                },
                {
                    "type": "ci",
                    "section": "CI",
                    "hidden": true
                },
                {
                    "type": "chore",
                    "section": "Inne",
                    "hidden": true
                }
            ]
        }
    }
}
