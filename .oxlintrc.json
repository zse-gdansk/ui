{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import"],
    "categories": {
        "correctness": "error",
        "suspicious": "warn",
        "perf": "warn"
    },
    "rules": {
        "react/react-in-jsx-scope": "off",
        "import/no-cycle": "error",
        "import/no-unassigned-import": [
            "warn",
            {
                "allow": ["**/*.css"]
            }
        ]
    },
    "env": {
        "builtin": true,
        "browser": true
    },
    "ignorePatterns": ["dist/**"]
}
