{
    "name": "@zse-gdansk/ui",
    "version": "0.0.0",
    "private": true,
    "workspaces": [
        "playground"
    ],
    "type": "module",
    "scripts": {
        "typecheck": "tsc --noEmit && tsc --noEmit -p playground && tsc --noEmit -p scripts",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "check": "bun run typecheck && bun run lint && bun run format:check",
        "prepare": "lefthook install",
        "dev": "bun --filter playground dev",
        "colors": "bun scripts/colors.ts && oxfmt src/styles/colors.css"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0"
    },
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "@types/culori": "^4.0.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "culori": "^4.0.2",
        "lefthook": "^2.1.14",
        "oxfmt": "^0.70.0",
        "oxlint": "^1.85.0",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    }
}
