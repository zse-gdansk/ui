{
    "name": "@zse-gdansk/ui",
    "version": "0.0.0",
    "description": "Wspólna biblioteka komponentów, tokenów i stylów dla projektów Zespołu Szkół Energetycznych w Gdańsku.",
    "homepage": "https://github.com/zse-gdansk/ui#readme",
    "bugs": {
        "url": "https://github.com/zse-gdansk/ui/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zse-gdansk/ui.git"
    },
    "workspaces": [
        "playground"
    ],
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./code-block": {
            "types": "./dist/code-block.d.ts",
            "default": "./dist/code-block.js"
        },
        "./styles.css": {
            "types": "./dist/styles/index.d.css.ts",
            "default": "./dist/styles/index.css"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "typecheck": "tsc --noEmit && tsc --noEmit -p playground && tsc --noEmit -p scripts",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "check": "bun run typecheck && bun run lint && bun run format:check",
        "doctor": "react-doctor --yes --verbose",
        "doctor:changed": "react-doctor --yes --verbose --scope changed --include-untracked --base ${DOCTOR_BASE:-main}",
        "doctor:score": "react-doctor --yes --score --no-color --project @zse-gdansk/ui",
        "doctor:badge": "bun run scripts/write-react-doctor-badge.ts",
        "build": "tsdown && cp -R src/styles src/fonts dist/",
        "prepublishOnly": "bun run check && bun run build",
        "prepare": "lefthook install",
        "dev": "bun --filter playground dev",
        "colors": "bun scripts/colors.ts && oxfmt src/styles/colors.css"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "@hugeicons/core-free-icons": "^4.3.5",
        "@hugeicons/react": "^1.1.10"
    },
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "@types/culori": "^4.0.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "culori": "^4.0.2",
        "lefthook": "^2.1.14",
        "oxfmt": "^0.70.0",
        "oxlint": "^1.85.0",
        "react-doctor": "^0.9.14",
        "shiki": "^4.4.3",
        "tsdown": "^0.23.0",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "shiki": "^4.4.3"
    },
    "peerDependenciesMeta": {
        "shiki": {
            "optional": true
        }
    }
}
